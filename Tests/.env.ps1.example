# /Tests/.env.ps1.example

# Copy this file to Tests/.env.ps1 and fill in your values.
# Tests/.env.ps1 is gitignored -- never commit it.

$env:IRT_TEST_TENANT_ID = ''
$env:IRT_TEST_USGOV_TENANT_ID = ''

$env:IRT_TEST_USER_ID = ''

# Object ID of a cloud-only user that destructive tests disable, sign out, and reset.
# Never a real person's account, and never the account you sign in with.
$env:IRT_TEST_DISPOSABLE_USER_ID = ''

$env:IRT_TEST_TENANT_ALIAS = ''

# Folder the playbook live test writes its investigation folder into, kept for review.
# Leave empty to use a temporary folder that is deleted after the test.
$env:IRT_TEST_OUTPUT_PATH = ''
